{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "target": "ES2020",
        "jsx": "react",
        "jsxFactory": "React.FC",
        "strict": true,
        "types": ["node"],
        "skipLibCheck": true,
        "baseUrl": "./",
        "paths": {
            "assets/*": ["./assets/*"],
            "components/*": ["./components/*"],
            "config/*": ["./config/*"],
            "constants/*": ["./constants/*"],
            "contexts/*": ["./contexts/*"],
            "hooks/*": ["./hooks/*"],
            "interfaces/*": ["./interfaces/*"],
            "models/*": ["./models/*"],
            "screens/*": ["./screens/*"],
            "types/*": ["./types/*"]
        },
    },
}
