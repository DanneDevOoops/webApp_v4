{
    "name": "Lager",
    "version": "5.2.0",
    "author": "Daniel Andersson",
    "description": "",
    "keywords": [
        "expo",
        "react-native",
        "typescript",
        "mobile app",
        "warehouse"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/DanneDevOoops/webApp_v4.git"
    },
    "bugs": {
        "url": "https://github.com/DanneDevOoops/webApp_v4/issues"
    },
    "main": "node_modules/expo/AppEntry.js",
    "engines": {
        "node": ">=20.19.0"
    },
    "assets": [
        "./assets/fonts/"
    ],
    "scripts": {
        "start": "npx expo start",
        "android": "npx expo start --android",
        "ios": "npx expo start --ios",
        "web": "npx expo start --web",
        "lint": "npx expo lint",
        "test": "jest --passWithNoTests",
        "docs": "typedoc --tsconfig ./tsconfig.json",
        "prebuild": "expo prebuild",
        "install-check": "npx expo install --check",
        "export": "npx expo export --channel stage",
        "publish": "expo publish",
        "ts:check": "tsc",
        "rn-doctor": "npx react-native doctor",
        "rn-help": "npx react-native help",
        "rn-info": "npx react-native info",
        "rn-link": "npx react-native link",
        "reinstall": "rm -rf node_modules && rm -rf package-lock.json && rm -rf yarn.lock && yarn install",
        "reinstall-dev": "rm -rf node_modules && rm -rf package-lock.json && rm -rf yarn.lock && yarn install --dev",
        "reinstall-dev-bun": "rm -rf node_modules && rm -rf package-lock.json && rm -rf yarn.lock && bun.lockb && bun install --dev",
        "reinstall-dev-npm": "rm -rf node_modules && rm -rf package-lock.json && rm -rf yarn.lock && bun.lockb && npm install --dev",
        "reinstall-dev-yarn": "rm -rf node_modules && rm -rf package-lock.json && rm -rf yarn.lock && bun.lockb && yarn install --dev"
    },
    "dependencies": {
        "@babel/preset-env": "^7.26.0",
        "@expo-google-fonts/josefin-sans": "^0.2.3",
        "@expo-google-fonts/merriweather": "^0.2.3",
        "@expo-google-fonts/oleo-script-swash-caps": "^0.2.3",
        "@expo/metro-runtime": "~4.0.1",
        "@react-native-community/datetimepicker": "8.2.0",
        "@react-native-masked-view/masked-view": "0.3.2",
        "@react-native-picker/picker": "2.9.0",
        "@react-navigation/bottom-tabs": "^6.5.20",
        "@react-navigation/native": "^6.1.17",
        "@react-navigation/native-stack": "^6.9.26",
        "@react-navigation/stack": "^6.3.29",
        "expo": "~52.0.38",
        "expo-app-loading": "~2.1.1",
        "expo-font": "~13.0.4",
        "expo-location": "~18.0.8",
        "expo-modules-autolinking": "^2.0.7",
        "expo-screen-orientation": "~8.0.4",
        "expo-secure-store": "~14.0.1",
        "expo-splash-screen": "~0.29.22",
        "expo-status-bar": "~2.0.1",
        "expo-updates": "~0.27.3",
        "jest": "~29.7.0",
        "jest-expo": "~52.0.6",
        "prop-types": "^15.8.1",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-native": "0.76.7",
        "react-native-flash-message": "^0.4.2",
        "react-native-gesture-handler": "~2.20.2",
        "react-native-maps": "1.18.0",
        "react-native-maps-directions": "^1.9.0",
        "react-native-pager-view": "6.5.1",
        "react-native-paper": "^5.12.3",
        "react-native-picker": "^4.3.7",
        "react-native-reanimated": "~3.16.1",
        "react-native-safe-area-context": "4.12.0",
        "react-native-screens": "~4.4.0",
        "react-native-tab-view": "^3.5.2",
        "react-native-vector-icons": "^10.2.0",
        "react-native-web": "~0.19.13"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@babel/eslint-parser": "^7.24.7",
        "@eslint/js": "^9.22.0",
        "@react-native-community/cli": "^15.1.3",
        "@react-native-community/eslint-config": "^3.2.0",
        "@testing-library/react-native": "^13.2.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/jest-native": "^5.4.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/react-hooks": "^8.0.1",
        "@types/jest": "^29.5.14",
        "@types/mocha": "^10.0.10",
        "@types/react": "~18.3.12",
        "@types/react-dom": "~18.3.1",
        "@types/react-test-renderer": "^19.0.0",
        "@typescript-eslint/eslint-plugin": "^8.26.1",
        "@typescript-eslint/parser": "^8.26.1",
        "eslint": "^9.22.0",
        "eslint-config-expo": "~8.0.1",
        "eslint-config-prettier": "^10.1.1",
        "eslint-config-react-app": "^7.0.1",
        "eslint-config-standard": "^17.1.0",
        "eslint-import-resolver-typescript": "^3.9.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.11.0",
        "eslint-plugin-jsdoc": "^50.6.6",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-n": "^16.0.0",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-promise": "^6.2.0",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-native": "^5.0.0",
        "eslint-plugin-testing-library": "^7.1.1",
        "eslint-plugin-tsdoc": "^0.4.0",
        "eslint-scope": "^8.0.1",
        "globals": "^15.15.0",
        "prettier": "^3.5.3",
        "prettier-plugin-import-sort": "^0.0.7",
        "react-test-renderer": "18.3.1",
        "ts-jest": "^29.3.0",
        "typedoc": "^0.28.0",
        "typedoc-plugin-coverage": "^3.4.1",
        "typedoc-plugin-dt-links": "^2.0.0",
        "typedoc-plugin-mdn-links": "^5.0.1",
        "typedoc-plugin-redirect": "^1.2.0",
        "typedoc-plugin-rename-defaults": "^0.7.3",
        "typedoc-umlclass": "^0.10.1",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.28.0"
    },
    "jest": {
        "preset": "jest-expo",
        "testEnvironment": "jest-environment-jsdom",
        "setupFilesAfterEnv": [
            "./node_modules/@testing-library/jest-native/extend-expect"
        ],
        "verbose": true,
        "bail": 0,
        "collectCoverage": true,
        "collectCoverageFrom": [
            "components/**/*.{ts,tsx}",
            "contexts/**/*.{ts,tsx}",
            "hooks/**/*.{ts,tsx}",
            "models/**/*.{ts,tsx}",
            "screens/**/*.{ts,tsx}"
        ],
        "coverageThreshold": {
            "global": {
                "lines": 20
            }
        },
        "coverageDirectory": "./docs/coverage/tests/",
        "coveragePathIgnorePatterns": [],
        "detectOpenHandles": true,
        "transformIgnorePatterns": [
            "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
        ]
    },
    "private": true
}
